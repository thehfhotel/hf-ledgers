# Copy to .env for local development. Never commit the real file — .env is
# gitignored. Production values are GitHub secrets, materialized into the
# container's .env by .github/workflows/deploy.yml; see README.md.

# ── frontend (expense-ledger) ────────────────────────────────────────────
TZ=Asia/Bangkok

# Where the frontend reaches the ezBookkeeping engine over the compose
# `default` network. Leave as-is unless you renamed the engine service.
ENGINE_URL=http://expense-ledger-engine:8080

# Bearer token minted from the engine's own UI (Settings > API token) after
# first-boot account creation — see README "First-boot procedure". Empty =
# the frontend's engine client stays dormant (src/server/engine.ts throws
# EngineNotConfiguredError instead of calling out).
ENGINE_API_TOKEN=

# Cloudflare Access JWT verification. For LAN-path requests this is the only
# gate, not defense-in-depth — see src/server/access.ts. ACCESS_AUD is what
# narrows a token to THIS app, so under NODE_ENV=production an empty value
# rejects every request (fail-closed); leave it empty only for local dev,
# which uses the DEV_USER bypass instead.
ACCESS_TEAM_DOMAIN=laikaexpress.cloudflareaccess.com
ACCESS_AUD=

# ── engine (expense-ledger-engine / ezBookkeeping) ───────────────────────
# Signs tokens and encrypts stored secrets — MUST be a random string in any
# real deployment (falls back to the insecure literal "ezbookkeeping" if
# unset). Generate with `openssl rand -base64 32`.
EBK_SECURITY_SECRET_KEY=

# Keep registration ON only for the first-boot account-creation window, then
# set to false. See README "First-boot procedure".
EBK_USER_ENABLE_REGISTER=false
